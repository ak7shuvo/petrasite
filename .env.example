# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real values.

# Public canonical URL, without a trailing slash. Used for canonical links, sitemap,
# robots.txt, Open Graph and structured data. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Where demo inquiries are delivered (Slack/Zapier/Make/CRM/your own endpoint). REQUIRED in production:
# without it, inquiries are NOT stored anywhere and visitors are asked to email instead.
# Must be https in production.
INQUIRY_WEBHOOK_URL=

# Optional shared secret. When set, each webhook request carries
#   x-petra-signature: sha256=<HMAC-SHA256 of the raw JSON body>
# so the receiver can verify the request came from this website.
INQUIRY_WEBHOOK_SECRET=
